{
  "name": "@keel-engine/codec",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "The bit codec: typed schemas, canonical bit-packed encoding, self-describing documents, a JSON view and a bit inspector -- the engine's packed form for objects, looks, worlds, particles and scripts.",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime.ts",
    "./retro": "./src/retro.ts",
    "./procedural-buffer": "./src/procedural-buffer.ts",
    "./schemas/*": "./src/schemas/*.ts",
    "./inspector": "./src/explain.ts",
    "./solidity": "./src/solidity.ts",
    "./registry": "./src/load.ts",
    "./hash": "./src/sha256.ts",
    "./byte-columns": "./src/byte-columns.ts"
  },
  "dependencies": {
    "@keel-engine/runtime": "workspace:*"
  },
  "devDependencies": {
    "@keel-engine/core": "workspace:*",
    "@keel-engine/object": "workspace:*",
    "@keel-engine/world": "workspace:*",
    "@keel-engine/entity": "workspace:*",
    "@keel-engine/particles": "workspace:*",
    "@keel-engine/audio": "workspace:*"
  }
}
