{
  "name": "@keel-engine/react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React host adapter for canonical KEEL runtime, renderer and design language.",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs"
    },
    "./design": "./src/design.ts",
    "./mcp": "./src/mcp.mjs",
    "./styles.css": "./src/styles.css",
    "./lifecycle": "./src/lifecycle.mjs",
    "./bundle": "./src/bundle.mjs"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0"
  },
  "dependencies": {
    "@keel-engine/core": "workspace:*",
    "@keel-engine/runtime": "workspace:*",
    "@keel-engine/render": "workspace:*",
    "@keel-engine/ui": "workspace:*"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "schema": "node scripts/export-schemas.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "playwright": "1.62.0"
  }
}
