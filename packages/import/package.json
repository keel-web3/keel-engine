    "./native-asset-compiler-v2": "./src/asset-compiler-v2.ts",
    "./native-asset-compiler-v4": "./src/asset-compiler-v4.ts",
    "./visual-asset-compiler": "./src/asset-compiler-visual.ts",
    "./topology-asset-compiler": "./src/asset-compiler-topology.ts",
    "./shared-asset-runtime": "./src/asset-replay-shared.ts",
    "./shared-asset-transport": "./src/asset-shared-transport.ts",
    "./asset-payload-selection": "./src/asset-payload-selection.ts",
    "./optimize-geometric-normals": "./src/asset-optimize-geometric-normals.ts",
    "./native-asset-compiler-v5": "./src/asset-compiler-v5.ts",
    "./preserved-asset-runtime": "./src/asset-replay-v5.ts",
    "./native-asset-compiler-v6": "./src/asset-compiler-v6.ts",
    "./native-asset-runtime": "./src/asset-replay-v6.ts",
    "./styled-asset": "./src/styled-asset-runtime.ts",
