    "@keel-engine/object": "workspace:*",
    "@keel-engine/runtime": "workspace:*",
    "buffer": "6.0.3",
    "fast-png": "6.2.0",
    "fflate": "0.8.2",
    "jpeg-js": "0.4.4",
    "meshoptimizer": "0.25.0",
    "@keel-engine/codec": "workspace:*"
  },
  "devDependencies": {
    "@keel-engine/keel": "workspace:*",
    "@keel-engine/render": "workspace:*"
  }
}
