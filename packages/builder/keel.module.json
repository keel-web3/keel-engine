{
  "protocol": "keel-module-manifest@1",
  "name": "keel-engine-builder",
  "version": "0.1.1",
  "description": "Voxel models palette-indexed by role, edited by ops, converted to objects, attributes and rigged entities, animated, varied by seed and exported as pack code.",
  "entry": "keel/entry.ts",
  "license": "MIT",
  "sourceRepository": {
    "url": "https://github.com/keel-web3/keel-engine",
    "revision": "replace-with-a-commit-hash",
    "path": "packages/builder"
  },
  "build": {
    "format": "iife",
    "external": [
      "@keel-engine/codec",
      "@keel-engine/core",
      "@keel-engine/entity",
      "@keel-engine/object",
      "@keel-engine/runtime",
      "@keel-engine/scene"
    ]
  }
}
